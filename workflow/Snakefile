# ==================================================================================================
# 9. Rules -- Detector simulation. One rule for every detector_simulation entry of type delphes;
#    each entry has its own folder: results/.../<det_sim>/<generator>.<detector>.root
# ==================================================================================================
P_DET_ROOT = wf_util.declare_path("results", f"{POINT}/{{det_sim}}/{{generator}}.{{detector}}.root")
P_LOG_DETSIM = wf_util.declare_path("results", f"{POINT}/logs/{{det_sim}}.{{generator}}.{{detector}}.log")

rule delphes:
    """Fast detector simulation of the HepMC events with Delphes."""
    input:
        hepmc=P_GEN_HEPMC,
    output:
        root=P_DET_ROOT,
    log:
        P_LOG_DETSIM,
    resources:
        mem_mb=4000,
        disk_mb=10000,
        runtime=60,
        **condor("delphes"),
    params:
        # the config names it card in one entry and delphes_card in the other: the first one found
        card=wf_util.param(("detector.delphes_card", "detector.card"), is_file=True),
    wildcard_constraints:
        det_sim=wf_util.match("det_sim", det_sim_type="delphes"),   # delphesCutlang|delphesOtherRecaster
    wrapper:
        wf_util.resolve_wrapper("delphes/DelphesHepMC2")


# ==================================================================================================
# 9. Rules -- Recasting
# ==================================================================================================

# The cutlang rule reads delphesCutlang, which this workflow's config defines. Keep it in one place:
# if a config names its delphes simulation differently, change this name, not the rule.
CUTLANG_DET_SIM = "delphesCutlang"


P_CUTLANG_ROOT = wf_util.declare_path("results", f"{POINT}/{RECAST}.root")
P_LOG_RECAST = wf_util.declare_path("results", f"{POINT}/logs/{RECAST}.log")

rule cutlang:
    """Recast a Delphes ROOT file with CutLang (ADL file of the analysis)."""
    input:
        root=wf_util.param_path(P_DET_ROOT, det_sim=CUTLANG_DET_SIM),
    output:
        root_out=P_CUTLANG_ROOT,
    log:
        P_LOG_RECAST,
    params:
        adl_file=wf_util.param(("recasting.settings.adl_file", "recasting.config.adl_file"), is_file=True),
        input_type="DELPHES",
    wildcard_constraints:
        recaster="cutlang",
    resources:
        mem_mb=4000,
        disk_mb=10000,
        runtime=60,
        **condor("cutlang"),
    wrapper:
        wf_util.resolve_wrapper("cutlang")

