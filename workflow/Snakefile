P_EMBAKE = wf_util.declare_path("results", f"{POINT}/{RECAST}.embake")                # also rivet_to_embake
P_LOG_EMBAKE = wf_util.declare_path("results", f"{POINT}/logs/{RECAST}.embake.log")   # also rivet_to_embake

rule cutlang_to_embake:
    """CutLang output -> .embake of one parameter point."""
    input:
        input = P_CUTLANG_ROOT,
    output:
        output = P_EMBAKE,
    log:
        P_LOG_EMBAKE,
    params:
        masses=wf_util.param("param_values"),
    wildcard_constraints:
        recaster="cutlang",
    resources:
        mem_mb=2000,
        disk_mb=5000,
        runtime=30,
    wrapper:
        wf_util.resolve_wrapper("cutlang_to_embake")


P_RIVET_YODA = wf_util.declare_path("results", f"{POINT}/{RECAST}.yoda.gz")

rule rivet:
    """Recast the HepMC events with Rivet (generator level)."""
    input:
        hepmc=P_GEN_HEPMC,
    output:
        yoda=P_RIVET_YODA,
    log:
        P_LOG_RECAST,
    params:
        analysis=wf_util.param("recasting.settings.analysis"),
    wildcard_constraints:
        recaster="rivet",
    resources:
        mem_mb=4000,
        disk_mb=10000,
        runtime=60,
        **condor("rivet"),
    wrapper:
        wf_util.resolve_wrapper("rivet")


rule rivet_to_embake:
    """Rivet YODA -> .embake of one parameter point."""
    localrule: True
    input:
        yoda=P_RIVET_YODA,
    output:
        embake=P_EMBAKE,
    params:
        masses=wf_util.param("param_values"),
    log:
        P_LOG_EMBAKE,
    wildcard_constraints:
        recaster="rivet",
    wrapper:
        wf_util.resolve_wrapper("rivet_to_embake")


# ==================================================================================================
# 9. Rules -- EMBake merge: every parameter point of a (process, generator, recaster, analysis) group
# ==================================================================================================
P_EMBAKED = wf_util.declare_path("results", f"{PROCESS}/{RECAST}.embaked")
P_LOG_EMBAKED = wf_util.declare_path("results", f"{PROCESS}/logs/{RECAST}.embaked.log")

PARTIAL_EMBAKE = wf_util.get_option("partial_embake")


def group_embakes(wildcards):
    """Every .embake of the group these wildcards belong to."""
    return wf_util.list_files(P_EMBAKE, same=("sqrts", "process", "generator", "recaster", "analysis"),
                              like=wildcards, existing_only=PARTIAL_EMBAKE)


rule create_em:
    """Merge the .embake files of all parameter points into one .embaked."""
    localrule: True
    input:
        group_embakes,
    output:
        embaked=P_EMBAKED,
    log:
        P_LOG_EMBAKED,
    script:
        wf_util.resolve_script("create_em.py")


# ==================================================================================================
# 10.-11. Targets: run_<rule> for every rule above, and the default target
# ==================================================================================================
wf_util.build_targets(selected)

for _name, _files in wf_util.list_target_files(by_rule=True).items():

    rule:
        name:
            f"run_{_name}"
        localrule: True
        input:
            _files,


rule all:
    default_target: True
    localrule: True
    input:
        wf_util.list_target_files(state="all"),

rule cleanall:
    message: "Removing all generated output files..."
    shell:
        """
        rm -rf results/ logs/ benchmark/ .snakemake/
        """
# ==================================================================================================
# 12. Report   13. Confirm (every real run; not with -n; not optional)
# ==================================================================================================
wf_util.print_report()
wf_util.show_target_files(state="waiting")    # --config show=target_files


onstart:
    wf_util.ask_confirmation()
